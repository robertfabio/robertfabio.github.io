    visibility: visible;
    transition: opacity 0.3s ease,
                visibility 0s linear 0s;
  }
}

/* Dark theme adjustments */
body.dark-theme #topbar {
  background-color: rgba(18, 18, 18, 0.95);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

@media (max-width: 480px) {
  body.dark-theme #topbar {
    background-color: rgba(18, 18, 18, 0.98);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
}

body.dark-theme #topbar nav {
  background-color: rgba(18, 18, 18, 0.98);
}

body.dark-theme .menu-toggle span {
  background-color: var(--primary);
}

/* Desktop Styles */
@media (min-width: 481px) {
  #topbar {
    position: sticky;
    background-color: rgba(255, 255, 255, 0.95);
  }

  .topbar {
    padding: 0 2rem;
  }

  #topbar nav {
    gap: 2.5rem;
  }

  #topbar nav a {
    font-size: 1rem;
  }
}

/* Larger screens */
@media (min-width: 1024px) {
  .topbar {
    padding: 0 4rem;
  }
}

/* Logo Container e Menu */
.logo-container {
  display: flex;
  align-items: center;
  position: relative;
  height: 100%;
}

#topbar .logo::before {
  content: '';
  position: sticky;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(131, 147, 224, 0.15), transparent);
  transition: left 0.8s ease;
}

#topbar .logo:hover::before {
  position: static 100%;
}

#topbar .logo.active {
  background-color: var(--accent);
  color: white;
  border-left: 5px solid var(--accent-dark);
  transform: scale(1.05);
}

.logo-menu {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: baseline;
  justify-content: flex-start;
  gap: 2px;
  top: 100%;
  left: 0;
  width: 170px;
  background-color: white;
  border-radius: 20px;
  box-shadow: 0 5px 20px rgba(10, 15, 20, 0.15);
  opacity: 0;
  visibility: visible;
  transform: translateY(0);
  transition: all 0.3s ease;
  z-index: 100;
  overflow: hidden;
  margin-top: 5px;
}

.logo-menu.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.logo-menu-item {
  display: flex;
  align-items: baseline;
  gap: 10px;
  padding: 12px 15px;
  color: var(--primary);
  transition: all 0.2s ease;
  border-left: 3px solid transparent;
}

.logo-menu-item:hover {
  background-color: var(--background-alternative);
  border-left: 3px solid var(--accent);
  padding-left: 18px;
}

.logo-menu-item i {
  color: var(--accent);
  width: 18px;
  text-align: center;
}

/* Dark Theme Support - Melhorado */
body.dark-theme {
  --background: #121212;
  --background-alternative: #1e1e1e;
  --primary: #e0e0e0;
  --primary-light: #a0a0a0;
  --card-shadow: rgba(0, 0, 0, 0.2);
  --card-shadow-hover: rgba(0, 0, 0, 0.3);
  --card-shadow-alt: rgba(0, 0, 0, 0.15);
  --line-gray: #333333;
  color: var(--primary);
}

body.dark-theme #topbar {
  background-color: rgba(18, 18, 18, 0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

body.dark-theme .menu-toggle span {
  background-color: var(--primary);
}

body.dark-theme #main-nav {
  background-color: var(--background);
  box-shadow: -5px 0 15px rgba(0, 0, 0, 0.3);
}

body.dark-theme #main-nav a {
  color: var(--primary);
  border-bottom-color: var(--line-gray);
}

body.dark-theme .card,
body.dark-theme .alternative .card,
body.dark-theme .exp-descriptions,
body.dark-theme #experience .experience {
  background-color: #1e1e1e;
  border-color: rgba(255, 255, 255, 0.05);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

body.dark-theme #experience .experience:hover,
body.dark-theme .card:hover {
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
}

body.dark-theme .alternative {
  background-color: #101010;
}

body.dark-theme .logo-menu {
  background-color: #1e1e1e;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
}

body.dark-theme #topbar .btn-toggler {
  border-color: #333333;
}

body.dark-theme a.card,
body.dark-theme .card a {
  color: var(--accent-light);
}

body.dark-theme .text-muted {
  color: #888888 !important;
}

body.dark-theme footer {
  color: var(--primary-light);
}

#topbar.sticky {
  position: sticky;
  top: 0;
  box-shadow: 0 5px 15px rgba(30, 41, 59, 0.08);
}

#topbar.shadow .topbar {
  padding: 0.8rem 1rem;
}

#topbar nav a::after {
  content: '';
  position: absolute;
  width: 0;
  height: 2px;
  bottom: 0;
  left: 0;
  background-color: var(--accent);
  transition: width 0.3s ease;
}

#topbar nav a:hover::after,
#topbar nav a.active::after {
  width: 100%;
}

/* Controles a direita */
.controls {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.theme-toggle {
  color: var(--primary);
  font-size: 1.2rem;
  cursor: pointer;
  transition: color 0.3s ease;
}

.theme-toggle:hover {
  color: var(--accent);
}