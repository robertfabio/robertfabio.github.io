/* Reset and Base Styles */
#topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 60px;
  background-color: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(30, 41, 59, 0.08);
  z-index: 1000;
  transition: background-color 0.3s ease, box-shadow 0.3s ease;
}

/* Topbar Container */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 100%;
  padding: 0 1.5rem;
  margin: 0 auto;
  max-width: 1200px;
}

/* Logo styles */
.logo-container {
  display: flex;
  align-items: center;
  position: relative;
  height: 100%;
}

#topbar .logo {
  height: 35px;
  padding: 0.25em 0.5em;
  color: var(--primary);
  font-weight: 700;
  letter-spacing: 1px;
  background-color: transparent;
  border-left: 3px solid var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
  z-index: 1001;
  cursor: pointer;
}

#topbar .logo:hover {
  background-color: rgba(var(--accent-rgb), 0.1);
}

/* Navigation */
#main-nav {
  display: flex;
  align-items: center;
  gap: 2.5rem;
}

#main-nav a {
  color: var(--primary);
  text-decoration: none;
  font-size: 1rem;
  font-weight: 500;
  padding: 0.5rem 0;
  position: relative;
  transition: all 0.3s ease;
}

#main-nav a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--accent);
  transition: width 0.3s ease;
}

#main-nav a:hover::after,
#main-nav a:focus::after {
  width: 100%;
}

/* Controls */
.controls {
  display: flex;
  align-items: center;
  gap: 1rem;
  z-index: 1001;
}

.theme-toggle {
  color: var(--primary);
  font-size: 1.2rem;
  cursor: pointer;
  transition: color 0.3s ease;
}

.theme-toggle:hover {
  color: var(--accent);
}

/* Menu Toggle Button */
.menu-toggle {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 24px;
  height: 20px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  z-index: 1001;
  margin-left: 1rem;
}

.menu-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background-color: var(--primary);
  border-radius: 4px;
  transition: transform 0.25s cubic-bezier(0.4, 0.0, 0.2, 1),
              opacity 0.25s cubic-bezier(0.4, 0.0, 0.2, 1),
              background-color 0.3s ease;
}

/* Mobile Navigation */
@media (max-width: 480px) {
  body {
    padding-top: 60px;
  }

  .topbar {
    padding: 0 1rem;
  }

  #topbar {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .menu-toggle {
    display: flex;
  }

  /* Menu Toggle Animation */
  .menu-toggle.active span:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
    background-color: var(--accent);
  }

  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
    transform: translateX(-10px);
  }

  .menu-toggle.active span:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
    background-color: var(--accent);
  }

  /* Mobile Navigation */
  #main-nav {
    position: fixed;
    top: 0;
    right: -280px;
    height: 100vh;
    width: 280px;
    background-color: var(--background);
    padding-top: 60px;
    transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.3s ease-in-out,
                opacity 0.3s ease-in-out;
    box-shadow: -2px 0 10px rgba(0, 0, 0, 0.1);
    z-index: 999;
    visibility: hidden;
    opacity: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #main-nav.active {
    right: 0;
    visibility: visible;
    opacity: 1;
  }

  #main-nav a {
    display: block;
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    font-size: 1.1rem;
  }

  #main-nav a:last-child {
    border-bottom: none;
  }

  #main-nav a:hover,
  #main-nav a:focus {
    background-color: rgba(var(--accent-rgb), 0.1);
    padding-left: 1.5rem;
  }

  #main-nav a::after {
    display: none;
  }

  /* Menu Overlay */
  .menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease,
                visibility 0s linear 0.3s;
    z-index: 998;
  }

  .menu-overlay.active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease,
                visibility 0s linear;
  }

  body.menu-open {
    overflow: hidden;
  }
}

/* Dark theme adjustments */
body.dark-theme #topbar {
  background-color: rgba(18, 18, 18, 0.98);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

@media (max-width: 480px) {
  body.dark-theme #topbar {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  body.dark-theme #main-nav {
    background-color: var(--background);
    box-shadow: -2px 0 10px rgba(0, 0, 0, 0.2);
  }

  body.dark-theme #main-nav a {
    border-bottom-color: rgba(255, 255, 255, 0.05);
  }
}

